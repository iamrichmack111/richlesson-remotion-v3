direction: down

repository: {
  label: "RICHLesson Repository"
  shape: cylinder
}

static: {
  label: "STATIC ANALYSIS"
  ruff: "Ruff"
  bandit: "Bandit"
  tsc: "TypeScript"
  shellcheck: "ShellCheck"
}

dependencies: {
  label: "SUPPLY CHAIN"
  npm: "npm"
  pip: "pip"
